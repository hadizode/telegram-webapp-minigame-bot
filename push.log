    "schema": "import { table, integer, text, boolean, index, unique, check, sql } from 'sdk/db';\n\n// NOTE: no foreign keys on this platform; integrity is enforced in app code.\nexport const users = table('users', {\n  id: integer('id').primaryKey({ autoIncrement: true }),\n  tgId: integer('telegram_id').notNull().unique(),\n  username: text('username'),\n  firstName: text('first_name'),\n  totalXp: integer('total_xp').notNull().default(0),\n  matchesPlayed: integer('matches_played').notNull().default(0),\n  matchesWon: integer('matches_won').notNull().default(0),\n  createdAt: integer('created_at', { mode: 'timestamp' }).default(sql`(unixepoch())`),\n});\n\nexport const matches = table('matches', {\n  id: integer('id').primaryKey({ autoIncrement: true }),\n  groupId: integer('group_id').notNull(),\n  packId: text('pack_id').notNull(),\n  maxPlayers: integer('max_players').notNull(),\n  status: text('status').notNull().default('open'),\n  messageId: integer('message_id'),\n  createdBy: integer('created_by').notNull(),\n  startedAt: integer('started_at', { mode: 'timestamp' }),\n  finishedAt: integer('finished_at', { mode: 'timestamp' }),\n  createdAt: integer('created_at', { mode: 'timestamp' }).default(sql`(unixepoch())`),\n}, (t) => ({\n  validStatus: check('valid_status', sql`${t.status} in ('open','full','running','finished','cancelled')`),\n  groupStatusIdx: index('idx_matches_group_status').on(t.groupId, t.status),\n}));\n\nexport const matchPlayers = table('match_players', {\n  id: integer('id').primaryKey({ autoIncrement: true }),\n  matchId: integer('match_id').notNull(),\n  userId: integer('user_id').notNull(), // users.id (internal id)\n  isActive: boolean('is_active').notNull().default(true),\n  rank: integer('rank'),\n  score: integer('score'),\n  lastSeen: integer('last_seen'), // unix ms, آخرین poll از Mini App\n  joinedAt: integer('joined_at', { mode: 'timestamp' }).default(sql`(unixepoch())`),\n}, (t) => ({\n  uq: unique('uq_match_user').on(t.matchId, t.userId),\n  activeIdx: index('idx_players_match_active').on(t.matchId, t.isActive),\n}));\n\n// Replaces Redis: wizard state with expiry (unix ms).\nexport const fsmSessions = table('fsm_sessions', {\n  id: text('id').primaryKey(),\n  data: text('data').notNull(),\n  expiresAt: integer('expires_at').notNull(),\n});\n\n// Replaces Redis locks (unix ms expiry).\nexport const locks = table('locks', {\n  id: text('id').primaryKey(),\n  token: text('token').notNull(),\n  expiresAt: integer('expires_at').notNull(),\n});\n\n// Append-only log of what happens in a match. Progress and ranking are computed from it.\n//   type 'digit_ok'    — a correct digit was accepted; `slot` = lock cell it filled (0..n-1)\n//   type 'digit_wrong' — a rejected attempt (used for the per-player cooldown); slot is NULL\n// unique(match_id, slot) guarantees a cell is filled once; NULL slots don't collide in SQLite.\nexport const matchEvents = table('match_events', {\n  id: integer('id').primaryKey({ autoIncrement: true }),\n  matchId: integer('match_id').notNull(),\n  userId: integer('user_id').notNull(), // users.id (internal id)\n  type: text('type').notNull(),\n  digit: integer('digit'),\n  slot: integer('slot'),\n  createdAt: integer('created_at', { mode: 'timestamp_ms' }).notNull(),\n}, (t) => ({\n  uqSlot: unique('uq_event_slot').on(t.matchId, t.slot),\n  matchTypeIdx: index('idx_events_match_type').on(t.matchId, t.type),\n}));\n\n// Shared puzzle state of a running match (one row per match).\n// state = JSON of the whole game (see lib/engine.js initialGame).\n// finished = JSON end screen written by lib/finish.js at conclude() (NULL until then) —\n// it lets still-polling clients receive the result instead of an error.\nexport const gameState = table('game_state', {\n  id: integer('id').primaryKey({ autoIncrement: true }),\n  matchId: integer('match_id').notNull().unique(),\n  state: text('state').notNull(),\n  finished: text('finished'),\n  updatedAt: integer('updated_at', { mode: 'timestamp' }).default(sql`(unixepoch())`),\n});\n",
    "lib/cards": "import { api } from 'sdk';\nimport { escapeHtml } from './core.js';\nimport { send, editText, tryApi, EMPTY_KB } from './tg.js';\nimport { getMatch, setMessageId } from './matches.js';\nimport { listActive } from './players.js';\nimport { getPack } from './packLoader.js';\n\nconst statusFa = (s, joined, max) => ({\n  open: `🟡 در انتظار بازیکن (${joined}/${max})`,\n  full: '🟢 همه حاضرن — منتظر شروع',\n  running: '🎮 در حال بازی',\n  finished: '🏁 تموم شد',\n  cancelled: '🚫 لغو شد',\n})[s];\n\nconst name = (p) => (p.username ? `@${escapeHtml(p.username)}` : escapeHtml(p.firstName));\n\nexport function buildCard(match, pack, players) {\n  const joined = players.length;\n  const list = joined ? players.map((p, i) => `${i + 1}. ${name(p)}`).join('\\n') : 'هنوز کسی جوین نشده';\n  const text = [\n    `🏥 <b>${escapeHtml(pack.name)}</b>`,\n    '━━━━━━━━━━━━━━',\n    `🎭 تم: ${escapeHtml(pack.theme_fa || pack.theme)}`,\n    `👥 ظرفیت: <b>${joined}/${match.maxPlayers}</b>`,\n    `⏳ وضعیت: ${statusFa(match.status, joined, match.maxPlayers)}`,\n    '',\n    '📌 <b>قبل از شروع</b>',\n    `• حداقل ${pack.min_players} نفر لازمه`,\n    '• یه وویس کال بزنید یا همین‌جا چت کنید',\n    '• اولین کسی که کد درست رو بزنه، رتبه ۱ می‌شه',\n    '',\n    '🧑‍🤝‍🧑 <b>بازیکن‌ها</b>',\n    list,\n  ].join('\\n');\n\n  const leaveBtn = { text: '❌ خروج', callback_data: `match:leave:${match.id}` };\n  let reply_markup = EMPTY_KB;\n  if (match.status === 'open') {\n    reply_markup = { inline_keyboard: [[\n      { text: '🚪 ورود', callback_data: `match:join:${match.id}` },\n      leaveBtn,\n    ]] };\n  } else if (match.status === 'full') {\n    // Leaving a full match reopens registration (see matchActions.leave).\n    reply_markup = { inline_keyboard: [[\n      { text: '▶️ شروع بازی', callback_data: `match:start:${match.id}` },\n      leaveBtn,\n    ]] };\n  }\n  return { text, reply_markup };\n}\n\nexport const pinCard = (match) =>\n  match.messageId\n    ? tryApi(() => api.pinChatMessage({\n      chat_id: match.groupId, message_id: match.messageId, disable_notification: true,\n    }), 'pin')\n    : undefined;\n\nexport async function postMatchCard(matchId) {\n  const match = await getMatch(matchId);\n  const { text, reply_markup } = buildCard(match, getPack(match.packId), await listActive(matchId));\n  const msg = await send(match.groupId, text, { reply_markup });\n  await setMessageId(matchId, msg.message_id);\n  await pinCard({ ...match, messageId: msg.message_id });\n}\n\nexport async function refreshCard(matchId) {\n  const match = await getMatch(matchId);\n  if (!match?.messageId) return;\n  const { text, reply_markup } = buildCard(match, getPack(match.packId), await listActive(matchId));\n  await editText(match.groupId, match.messageId, text, reply_markup);\n}\n\nexport const unpinCard = (match) =>\n  tryApi(() => api.unpinChatMessage({ chat_id: match.groupId, message_id: match.messageId }), 'unpin');",
    "lib/commands": "import { api } from 'sdk';\nimport { isAdminMessage, isGroup } from './gate.js';\nimport { escapeHtml, formatDate } from './core.js';\nimport { send, editText, EMPTY_KB } from './tg.js';\nimport { upsertUser, getUserByTgId, topUsers, titleFor, nextTitle } from './users.js';\nimport { findOpenByGroup, setStatus } from './matches.js';\nimport { countActive } from './players.js';\nimport { getPack } from './packLoader.js';\nimport { unpinCard } from './cards.js';\nimport { startMatch } from './matchActions.js';\nimport { begin } from './wizard.js';\nimport { testapp } from './testapp.js';\n\nconst LINE = '━━━━━━━━━━━━━━━━';\n\n// Middleware equivalents: groupOnly -> adminOnly (admin checked via getChatMember).\nconst guard = ({ group, admin }, fn) => async (msg) => {\n  if (group && !isGroup(msg.chat)) return send(msg.chat.id, '👥 این دستور فقط توی گروه کار می‌کنه');\n  if (admin && !(await isAdminMessage(msg))) {\n    const replyOptions = {reply_to_message_id: msg.message_id,};\n    return send(msg.chat.id, '⛔ فقط ادمین‌ها می‌تونن این کار رو بکنن',replyOptions);\n  }\n  return fn(msg);\n};\n\nasync function start(msg) {\n  const replyOptions = {reply_to_message_id: msg.message_id,};\n\n  if (msg.chat.type === 'private') {\n    const me = await api.getMe();\n    return send(\n      msg.chat.id,\n      [\n        '🔐 <b>به اتاق فرار خوش اومدی!</b>',\n        LINE,\n        'من یه ربات بازی گروهی‌ام؛ تیمی وارد اتاق‌ها می‌شید، معماها رو حل می‌کنید و رقابت می‌کنید کی اول خارج بشه.',\n        '',\n        '⚠️ من فقط توی گروه کار می‌کنم.',\n        `➕ <a href=\"https://t.me/${me.username}?startgroup=true\">منو به گروهت اضافه کن</a>`,\n        '',\n        '📖 برای دیدن دستورات: /help',\n      ].join('\\n'),\n      replyOptions\n    );\n  }\n\n  return send(\n    msg.chat.id,\n    [\n      '🔐 <b>آماده ماجراجویی هستی؟؟</b>',\n      LINE,\n      '👤 /profile — پروفایل من',\n      '🏆 /ranklist — جدول برترین‌ها',\n      '📖 /help — راهنمای کامل',\n    ].join('\\n'),\n    replyOptions\n  );\n}\n\nasync function help(msg) {\n  const replyOptions = { reply_to_message_id: msg.message_id,};\n\n  const lines = [\n    '📖 <b>راهنمای دستورات</b>',\n    LINE,\n    '🔐 /start — معرفی ربات',\n    '👤 /profile — پروفایل و امتیازها',\n    '🏆 /ranklist — ۲۰ نفر برتر',\n  ];\n  if (isGroup(msg.chat) && (await isAdminMessage(msg))) {\n    lines.push('', '👑 <b>مخصوص ادمین‌ها</b>', LINE,\n      '🎮 /newmatch — ساخت مچ جدید',\n      '▶️ /forcematch — شروع اجباری مچ',\n      '❌ /cancelmatch — لغو مچ باز');\n  }\n  return send(msg.chat.id, lines.join('\\n'),replyOptions);\n}\n\nexport function renderProfile(u) {\n  const created = u.createdAt instanceof Date ? u.createdAt : new Date(u.createdAt * 1000);\n  const next = nextTitle(u.totalXp);\n  const lines = [\n    `👤 <b>${escapeHtml(u.firstName)}</b>${u.username ? ` · @${escapeHtml(u.username)}` : ''}`,\n    LINE,\n    `🎖 لقب: <b>${titleFor(u.totalXp)}</b>`,\n    `⭐ امتیاز: <b>${u.totalXp}</b> XP`,\n    `🎮 بازی‌ها: <b>${u.matchesPlayed}</b>`,\n    `🏆 بردها: <b>${u.matchesWon}</b>`,\n    `📅 عضویت: ${formatDate(created)}`,\n  ];\n  if (next) lines.push('', `🚀 ${next.left} XP تا لقب «${next.title}»`);\n  return lines.join('\\n');\n}\n\nexport async function sendProfileByTgId(chatId, tgId, msg) {\n  const replyOptions = msg ? { reply_to_message_id: msg.message_id } : {};\n  const u = await getUserByTgId(tgId);\n  return send(chatId, u ? renderProfile(u) : '🔎 کاربر پیدا نشد',replyOptions);\n}\n\nasync function profile(msg) {\n  const replyOptions = { reply_to_message_id: msg.message_id,};\n  const u = await upsertUser(msg.from);\n  return send(msg.chat.id, renderProfile(u),replyOptions);\n}\n\nasync function ranklist(msg) {\n  const replyOptions = { reply_to_message_id: msg.message_id,};\n  const list = await topUsers(20);\n  if (!list.length) return send(msg.chat.id, '🏆 هنوز کسی توی جدول نیست. اولین نفر باش!',replyOptions);\n  const medals = ['🥇', '🥈', '🥉'];\n  const rows = list.map((u, i) => {\n    const mark = medals[i] || `<b>${i + 1}.</b>`;\n    const name = escapeHtml(u.firstName || u.username || 'ناشناس');\n    return `${mark} ${name} — ${u.totalXp} XP · ${titleFor(u.totalXp)}`;\n  });\n  return send(msg.chat.id, ['🏆 <b>جدول برترین‌ها</b>', LINE, ...rows].join('\\n'),replyOptions);\n}\n\nasync function cancelmatch(msg) {\n  const replyOptions = { reply_to_message_id: msg.message_id,};\n  const match = await findOpenByGroup(msg.chat.id);\n  if (!match) return send(msg.chat.id, '🔎 الان مچ بازی توی این گروه نیست',replyOptions);\n  await setStatus(match.id, 'cancelled');\n  if (match.messageId) await editText(match.groupId, match.messageId, '🚫 این مچ لغو شد', EMPTY_KB);\n  await unpinCard(match);\n  return send(msg.chat.id, '🚫 مچ لغو شد',replyOptions);\n}\n\nasync function forcematch(msg) {\n  const replyOptions = { reply_to_message_id: msg.message_id,};\n  const match = await findOpenByGroup(msg.chat.id);\n  if (!match) return send(msg.chat.id, '🔎 الان مچ بازی توی این گروه نیست',replyOptions);\n  const pack = getPack(match.packId);\n  if ((await countActive(match.id)) < pack.min_players) {\n    return send(msg.chat.id, `👥 حداقل ${pack.min_players} نفر لازمه`,replyOptions);\n  }\n  return startMatch(match, '🛠 موتور بازی هنوز وصل نشده (فاز بعدی)');\n}\n\nexport const COMMANDS = {\n  start, help, profile, ranklist,testapp,\n  newmatch: guard({ group: true, admin: true }, begin),\n  cancelmatch: guard({ group: true, admin: true }, cancelmatch),\n  forcematch: guard({ group: true, admin: true }, forcematch),\n};\n",
    "lib/engine": "// Pure puzzle engine: no DB, no Telegram. An \"interactive room\" is plain data (see packs/hospital/power.js)\n// that lives in pack.rooms[<id>] next to the old hotspot-only rooms; it is recognised by having `objects`.\n//\n// Room fields: name_fa, bg, digits[], start (view name), views{name:{image, rules?}}, items{type:{name,image}},\n//              win{requires:[objectIds], text}, objects{...}, rules[]\n// Object fields (view,x,y,w,h required; action required unless the object has rules):\n//   action    examine | play | pickup | place | use | toggle | goto\n//   to        goto: target view (client-side only)\n//   item      pickup: item type added to the team inventory\n//   accepts   place: item type that must be selected (consumed)\n//   requires  [objectIds] that must already be \"done\" (not idle/hidden)\n//   sets      { objectId: state } applied on success (also reveals hidden objects with 'idle')\n//   setState  state of this object after success (default: pickup->taken, examine->none, else done)\n//   text / failText / doneText   messages\n//   decoy     always fails with failText\n//   hidden    starts invisible until another object sets it to 'idle'\n//   audio     sound file under public/ (played for the actor; others get a play button in the log)\n//   image / images{state} / labels{state}   visuals; an image given as {image,x,y,w,h} is a full-frame layer\n//   rules     [{on, if, do, else}] — the open-ended event system, documented at the top of lib/rules.js.\n//             The legacy fields above are compiled into rules internally (rules.js: legacyRules).\n// `win` is optional when some rule of the room has a {solve:<thisRoom>} effect.\n\nimport { ENTER_PREFIX, hasSolveFor, isDone, ruleErrors, runAct, runEnter } from './rules.js';\n\nexport { ENTER_PREFIX };\nexport const ACTIONS = ['examine', 'play', 'pickup', 'place', 'use', 'toggle', 'goto'];\nconst PUBLIC = ['view', 'x', 'y', 'w', 'h', 'image', 'images', 'labels', 'action', 'to'];\n\nexport const isInteractive = (room) => !!room && typeof room.objects === 'object';\n\n// Problems in an interactive room definition; empty = valid. `rooms` (all pack rooms) enables cross-room refs.\nexport function roomErrors(id, room, rooms = { [id]: room }) {\n  const errs = [];\n  const views = room.views || {};\n  const objs = room.objects || {};\n  const start = room.start || Object.keys(views)[0];\n  if (!start || !views[start]) errs.push(`${id}: needs a valid start view`);\n  const cx = (where) => ({ rooms, roomId: id, where });\n  for (const [oid, o] of Object.entries(objs)) {\n    const at = `${id}.${oid}`;\n    if (/[:=]/.test(oid) || oid.startsWith('@')) errs.push(`${at}: object id must not contain \":\" or \"=\" or start with \"@\"`);\n    if (!views[o.view]) errs.push(`${at}: unknown view \"${o.view}\"`);\n    for (const k of ['x', 'y', 'w', 'h']) if (typeof o[k] !== 'number') errs.push(`${at}: ${k} must be a number`);\n    if (o.action === undefined && !(Array.isArray(o.rules) && o.rules.length)) errs.push(`${at}: needs an action or rules`);\n    if (o.action !== undefined && !ACTIONS.includes(o.action)) errs.push(`${at}: unknown action \"${o.action}\"`);\n    if (o.action === 'goto' && !views[o.to]) errs.push(`${at}: goto unknown view \"${o.to}\"`);\n    if (o.action === 'place' && !o.decoy && !o.accepts) errs.push(`${at}: place needs \"accepts\"`);\n    for (const r of o.requires || []) if (!objs[r]) errs.push(`${at}: requires unknown object \"${r}\"`);\n    for (const k of Object.keys(o.sets || {})) if (!objs[k]) errs.push(`${at}: sets unknown object \"${k}\"`);\n    errs.push(...ruleErrors(at, o.rules, cx('object')));\n  }\n  for (const [vid, v] of Object.entries(views)) {\n    if (/[:=]/.test(vid)) errs.push(`${id}.${vid}: view id must not contain \":\" or \"=\"`);\n    errs.push(...ruleErrors(`${id}.views.${vid}`, v.rules, cx('view')));\n  }\n  errs.push(...ruleErrors(id, room.rules, cx('room')));\n  const need = room.win?.requires;\n  if (room.win || !hasSolveFor(room, id)) {\n    if (!Array.isArray(need) || !need.length) errs.push(`${id}: needs win.requires`);\n    else for (const r of need) if (!objs[r]) errs.push(`${id}: win requires unknown object \"${r}\"`);\n  }\n  return errs;\n}\n\n// Whole-match state: shared inventory/log/seq, per-room object states, solved rooms,\n// plus rule state (flags, image/background overrides, rooms whose digits were revealed early).\nexport function initialGame(pack, roomIds) {\n  const objs = {};\n  for (const id of roomIds) {\n    const room = pack.rooms[id];\n    if (!isInteractive(room)) continue;\n    objs[id] = {};\n    for (const [oid, o] of Object.entries(room.objects)) objs[id][oid] = o.hidden ? 'hidden' : 'idle';\n  }\n  return { seq: 0, log: [], inv: [], objs, done: {}, flags: {}, imgs: {}, bgs: {}, shown: [] };\n}\n\n// What the Mini App may see of an interactive room (never rules/requires/sets/accepts/texts).\nexport function publicRoom(id, room, gs) {\n  const objects = [];\n  for (const [oid, o] of Object.entries(room.objects)) {\n    const state = gs.objs[id][oid];\n    if (state === 'hidden' || state === 'taken') continue;\n    const p = { id: oid, state };\n    for (const k of PUBLIC) if (o[k] !== undefined) p[k] = o[k];\n    const ov = gs.imgs?.[`${id}:${oid}`];\n    if (ov !== undefined) { p.image = ov; delete p.images; }\n    objects.push(p);\n  }\n  const roomEnter = (room.rules || []).some((r) => r.on === 'enter');\n  const views = {};\n  for (const [vn, v] of Object.entries(room.views)) {\n    const { rules, ...rest } = v;\n    views[vn] = { ...rest, image: gs.bgs?.[`${id}:${vn}`] ?? v.image };\n    if (roomEnter || (rules || []).some((r) => r.on === 'enter')) views[vn].enter = true; // lets the client skip pointless calls\n  }\n  const done = !!gs.done[id];\n  return {\n    id,\n    name: room.name_fa || room.name || id,\n    start: room.start || Object.keys(room.views)[0],\n    views,\n    items: room.items || {},\n    objects,\n    done,\n    win: done ? { text: room.win?.text, digits: room.digits || [] } : null,\n  };\n}\n\n// rooms = { roomId: interactiveRoom } of the ACTIVE rooms. Mutates gs only when something changed.\n// Returns { ok, text?, audio?, changed, solved, solvedRooms, msgs[], read?, goto?{room,view}, error? }.\nexport const act = (rooms, roomId, gs, id, withItem, by) => runAct(rooms, roomId, gs, id, withItem, by);\n\n// The player entered a view: runs `enter` rules.\nexport const enter = (rooms, roomId, gs, view, by) => runEnter(rooms, roomId, gs, view, by);\n\nexport { isDone };\n",
    "lib/fsm": "import { db } from 'sdk';\nimport { maybeSweep } from './core.js';\n\nconst TTL_MS = 5 * 60 * 1000;\nexport const fsmKey = (chatId, userId) => `newmatch:${chatId}:${userId}`;\n\nexport async function loadState(id) {\n  const row = await db.get('SELECT data, expires_at FROM fsm_sessions WHERE id = :id', { ':id': id });\n  if (!row) return null;\n  if (row.expires_at < Date.now()) { await clearState(id); return null; }\n  return JSON.parse(row.data);\n}\n\n// Every save refreshes the 5-minute TTL (and occasionally sweeps expired rows).\nexport async function saveState(id, state) {\n  await maybeSweep();\n  return db.run('INSERT OR REPLACE INTO fsm_sessions (id, data, expires_at) VALUES (:id, :data, :exp)', {\n    ':id': id, ':data': JSON.stringify(state), ':exp': Date.now() + TTL_MS,\n  });\n}\n\nexport const clearState = (id) => db.run('DELETE FROM fsm_sessions WHERE id = :id', { ':id': id });",
    "lib/game": "import { act, enter, ENTER_PREFIX, initialGame, isInteractive } from './engine.js';\nimport { createGame, getGame, saveGame } from './core.js';\nimport { acquireLock } from './core.js';\nimport { getPack, getVariant } from './packLoader.js';\nimport { activeInteractive, buildSnapshot } from './snapshot.js';\nimport { send, tryApi } from './tg.js';\nimport { escapeHtml } from './core.js';\n\nasync function locked(matchId, fn) {\n  let release;\n  try { release = await acquireLock(`game:${matchId}`, 4000); } catch { return { busy: true }; }\n  try { return await fn(); } finally { await release(); }\n}\n\n// The match's team size picks the variant, which picks the active rooms.\nconst activeRooms = (pack, match) => getVariant(pack, match.maxPlayers).rooms;\n\nexport function startGame(match) {\n  const pack = getPack(match.packId);\n  return createGame(match.id, initialGame(pack, activeRooms(pack, match)));\n}\n\n// What the Mini App sees: lobby + hotspot rooms, interactive rooms, shared inventory/log.\n// Rules, answers and digits of unsolved rooms never leave the server. (Pure part: lib/snapshot.js.)\nexport async function snapshot(match) {\n  const g = await getGame(match.id);\n  if (!g) return null;\n  const pack = getPack(match.packId);\n  return buildSnapshot(pack, activeRooms(pack, match), JSON.parse(g.state), match.maxPlayers);\n}\n\n// objectId '@enter:<view>' = \"the player entered that view\" (runs `enter` rules); anything else is a click.\nexport const playerAct = (match, user, roomId, objectId, withItem) => locked(match.id, async () => {\n  const g = await getGame(match.id);\n  if (!g) return { result: { ok: false, text: '⚠️ بازی هنوز آماده نیست' } };\n  const pack = getPack(match.packId);\n  const room = pack.rooms[roomId];\n  const active = activeRooms(pack, match);\n  if (!active.includes(roomId) || !isInteractive(room)) {\n    return { result: { ok: false, text: '🔎 این اتاق وجود نداره' } };\n  }\n  const gs = JSON.parse(g.state);\n  const view = objectId.startsWith(ENTER_PREFIX) ? objectId.slice(ENTER_PREFIX.length) : null;\n  if (view === null && gs.done[roomId]) return { result: { ok: true, text: '🏁 این اتاق حل شده' } };\n\n  const rooms = activeInteractive(pack, active);\n  const by = user.firstName || user.username || 'یکی از بازیکن‌ها';\n  const r = view !== null ? enter(rooms, roomId, gs, view, by) : act(rooms, roomId, gs, objectId, withItem, by);\n  if (r.error) console.error('rules aborted:', r.error, roomId, objectId);\n  const result = { ok: r.ok, text: r.text, audio: r.audio, msgs: r.msgs, read: r.read, goto: r.goto };\n  if (!r.changed) return { result };\n\n  await saveGame(match.id, { state: JSON.stringify(gs) });\n  for (const rid of r.solvedRooms || []) {\n    await tryApi(() => send(match.groupId, `🔓 اتاق «${escapeHtml(pack.rooms[rid].name_fa || rid)}» حل شد!`), 'solved');\n  }\n  return { result };\n});",
    "lib/gameApi": "import { EndpointError } from 'sdk';\nimport { getMatch } from './matches.js';\nimport { getUserByTgId } from './users.js';\nimport { getActive, touch } from './players.js';\n\n// The Mini App is opened with ?startapp=m<matchId>; the platform verifies initData, we verify membership.\n// `touch` keeps the presence record alive (presence.closeAbandoned watches it).\nexport async function requirePlayer(ctx) {\n  const tg = ctx.initData?.user;\n  const m = /^m(\\d+)$/.exec(ctx.initData?.start_param || '');\n  if (!tg || !m) throw new EndpointError('بازی رو از دکمه‌ی توی گروه باز کن', { code: 'NO_MATCH' });\n  const match = await getMatch(Number(m[1]));\n  if (!match || match.status !== 'running') throw new EndpointError('این مچ در حال اجرا نیست', { code: 'NOT_RUNNING' });\n  const user = await getUserByTgId(tg.id);\n  if (!user || !(await getActive(match.id, user.id))) {\n    throw new EndpointError('تو توی این مچ نیستی', { code: 'NOT_PLAYER' });\n  }\n  await touch(match.id, user.id);\n  return { match, user };\n}\n\n// Same as requirePlayer but also lets a FINISHED match through: players whose client is\n// still polling must receive the end screen instead of an error. No touch() — presence\n// no longer matters once the match is over.\nexport async function requireAnyPlayer(ctx) {\n  const tg = ctx.initData?.user;\n  const m = /^m(\\d+)$/.exec(ctx.initData?.start_param || '');\n  if (!tg || !m) throw new EndpointError('بازی رو از دکمه‌ی توی گروه باز کن', { code: 'NO_MATCH' });\n  const match = await getMatch(Number(m[1]));\n  if (!match || !['running', 'finished'].includes(match.status)) {\n    throw new EndpointError('این مچ در حال اجرا نیست', { code: 'NOT_RUNNING' });\n  }\n  const user = await getUserByTgId(tg.id);\n  if (!user || !(await getActive(match.id, user.id))) {\n    throw new EndpointError('تو توی این مچ نیستی', { code: 'NOT_PLAYER' });\n  }\n  if (match.status === 'running') await touch(match.id, user.id);\n  return { match, user };\n}\n",
    "lib/gameEngine": "import { api } from 'sdk';\nimport { getMatch } from './matches.js';\nimport { getPack } from './packLoader.js';\nimport { send } from './tg.js';\nimport { startGame } from './game.js';\nimport { escapeHtml } from './core.js';\n\n// Called by startMatch (/forcematch and the start button) after status = running.\nexport async function onMatchStart(matchId) {\n  const match = await getMatch(matchId);\n  const pack = getPack(match.packId);\n  await startGame(match);\n  const me = await api.getMe();\n  await send(match.groupId, [\n    '🔐 <b>بازی شروع شد!</b>',\n    '━━━━━━━━━━━━━━',\n    escapeHtml(pack.intro_fa || 'وارد لابی بشید، اتاق‌ها رو بگردید و رقم‌های قفل خروج رو پیدا کنید.'),\n  ].join('\\n'), {\n    reply_markup: { inline_keyboard: [[{ text: '🚪 ورود به لابی',url: `https://t.me/${me.username}?startapp=m${matchId}&mode=fullscreen` }]] },\n  });\n}\n",
    "lib/matchActions": "import { isChatAdmin } from './gate.js';\nimport { acquireLock } from './core.js';\nimport { send } from './tg.js';\nimport { upsertUser } from './users.js';\nimport { getMatch, setStatus } from './matches.js';\nimport { addPlayer, countActive, deactivate, getActive } from './players.js';\nimport { computeStatus } from './capacity.js';\nimport { refreshCard, unpinCard, pinCard } from './cards.js';\nimport { onMatchStart } from './gameEngine.js';\nimport { api } from 'sdk';\n\n// Shared by /forcematch and the start button.\n// If the engine fails to start, the match goes back to its previous registration\n// state (open/full) instead of being stuck as \"running\".\nexport async function startMatch(match, notReadyText) {\n  await setStatus(match.id, 'running');\n  try {\n    await onMatchStart(match.id);\n  } catch (e) {\n    console.error('onMatchStart failed', e.message);\n    await setStatus(match.id, 'full');\n    await refreshCard(match.id);\n    await send(match.groupId, notReadyText);\n  }\n  await unpinCard(match);\n  await refreshCard(match.id);\n}\n\n// c = { chatId, from }\nasync function join(c, id) {\n  const match = await getMatch(id);\n  if (!match || match.status !== 'open') return send(c.chatId, '🚪 ثبت‌نام این مچ بسته شده');\n  const member = await api.getChatMember({ chat_id: match.groupId, user_id: c.from.id });\n  if (['left', 'kicked'].includes(member.status)) return send(c.chatId, '👥 اول باید عضو گروه باشی');\n  const user = await upsertUser(c.from);\n  if (await getActive(id, user.id)) return;\n  if ((await countActive(id)) >= match.maxPlayers) return send(c.chatId, '😅 ظرفیت پر شده');\n  await addPlayer(id, user.id);\n  const status = computeStatus(await countActive(id), match.maxPlayers);\n  if (status === 'full') await setStatus(id, 'full');\n  await refreshCard(id);\n  if (status === 'full') await send(match.groupId, '🎉 همه حاضرن! ادمین می‌تونه بازی رو شروع کنه ▶️');\n}\n\n// Allowed while open AND full. Leaving a full match reopens registration.\nasync function leave(c, id) {\n  const match = await getMatch(id);\n  if (!match || !['open', 'full'].includes(match.status)) return;\n  const user = await upsertUser(c.from);\n  if (!(await getActive(id, user.id))) return;\n  await deactivate(id, user.id);\n  if (match.status === 'full') {\n    await setStatus(id, 'open');\n    await refreshCard(id);\n    return send(match.groupId, '🚪 یه نفر خارج شد؛ ثبت‌نام دوباره بازه!');\n  }\n  await refreshCard(id);\n}\n\nasync function start(c, id) {\n  if (!(await isChatAdmin(c.chatId, c.from.id))) return send(c.chatId, '⛔ فقط ادمین‌ها می‌تونن این کار رو بکنن');\n  const match = await getMatch(id);\n  if (!match || match.status !== 'full') return;\n  return startMatch(match, '🛠 موتور بازی هنوز آماده نیست');\n}\n\nconst actions = { join, leave, start };\n\nexport async function handleMatchAction(c, action, id) {\n  let release;\n  try {\n    release = await acquireLock(`match:${id}`, 3000);\n  } catch {\n    return send(c.chatId, '⏳ یه لحظه صبر کن و دوباره امتحان کن');\n  }\n  try {\n    return await actions[action](c, id);\n  } finally {\n    await release();\n  }\n}",
    "lib/matches": "import { db } from 'sdk';\nimport { eq, and, inArray } from 'sdk/db';\nimport { matches } from '../schema.js';\nimport { first } from './core.js';\n\nexport const getMatch = (id) => db.select().from(matches).where(eq(matches.id, id)).get();\n\nexport const findOpenByGroup = (groupId) =>\n  db.select().from(matches)\n    .where(and(eq(matches.groupId, groupId), inArray(matches.status, ['open', 'full'])))\n    .get();\n\nexport async function createMatch({ groupId, packId, maxPlayers, createdBy }) {\n  const res = await db.insert(matches)\n    .values({ groupId, packId, maxPlayers, createdBy })\n    .returning()\n    .run();\n  return first(res);\n}\n\nexport function setStatus(id, status) {\n  let set = { status };\n  if (status === 'running') set = { status, startedAt: new Date() };\n  // Going back to registration (e.g. engine failed to start) clears the start time.\n  else if (status === 'open' || status === 'full') set = { status, startedAt: null };\n  // Terminal states stamp finishedAt (used by reports; end-of-match logic lives in lib/finish.js).\n  else if (status === 'finished' || status === 'cancelled') set = { status, finishedAt: new Date() };\n  return db.update(matches).set(set).where(eq(matches.id, id)).run();\n}\n\nexport const setMessageId = (id, messageId) =>\n  db.update(matches).set({ messageId }).where(eq(matches.id, id)).run();",
    "lib/packLoader": "import { isInteractive, roomErrors } from './engine.js';\nimport { PACKS } from './packs/index.js';\n\nconst REQUIRED = ['theme', 'name', 'min_players', 'max_players', 'lobby', 'rooms', 'variants'];\nconst HOTSPOT_TYPES = ['door', 'clue', 'lock'];\n\nfunction sceneErrors(label, scene, roomIds) {\n  const errs = [];\n  const seen = new Set();\n  for (const h of scene.hotspots ?? []) {\n    if (!h.id || seen.has(h.id)) errs.push(`${label}: hotspot id missing or duplicate (${h.id})`);\n    seen.add(h.id);\n    if (!HOTSPOT_TYPES.includes(h.type)) errs.push(`${label}.${h.id}: unknown type \"${h.type}\"`);\n    if (h.type === 'door' && h.to !== 'lobby' && !roomIds.includes(h.to)) {\n      errs.push(`${label}.${h.id}: door to unknown scene \"${h.to}\"`);\n    }\n    if (h.type === 'clue' && !h.content?.kind) errs.push(`${label}.${h.id}: clue needs content.kind`);\n  }\n  return errs;\n}\n\n// Returns a list of problems; empty list = valid pack.\nexport function validatePack(p) {\n  const errs = REQUIRED.filter((k) => p?.[k] === undefined).map((k) => `missing ${k}`);\n  if (errs.length) return errs;\n\n  const roomIds = Object.keys(p.rooms);\n  errs.push(...sceneErrors('lobby', p.lobby, roomIds));\n  if ((p.lobby.hotspots ?? []).filter((h) => h.type === 'lock').length !== 1) {\n    errs.push('lobby needs exactly one \"lock\" hotspot');\n  }\n  for (const [id, r] of Object.entries(p.rooms)) {\n    // Interactive rooms (views + objects) are checked by the engine (with all rooms, for cross-room refs);\n    // the rest are hotspot scenes.\n    errs.push(...(isInteractive(r) ? roomErrors(id, r, p.rooms) : sceneErrors(id, r, roomIds)));\n    const okDigits = Array.isArray(r.digits) && r.digits.every((d) => Number.isInteger(d) && d >= 0 && d <= 9);\n    if (!okDigits) errs.push(`${id}: digits must be an array of integers 0-9`);\n  }\n  for (const [cap, v] of Object.entries(p.variants)) {\n    const n = Number(cap);\n    const unknown = (v.rooms ?? []).filter((r) => !roomIds.includes(r));\n    if (unknown.length) { errs.push(`variant ${n}: unknown rooms ${unknown.join(',')}`); continue; }\n    const total = v.rooms.reduce((s, r) => s + (p.rooms[r].digits?.length ?? 0), 0);\n    if (total !== n) errs.push(`variant ${n}: active rooms hold ${total} digits, lock needs ${n}`);\n    if (!(v.minutes > 0)) errs.push(`variant ${n}: minutes must be > 0`);\n  }\n  return errs;\n}\n\nexport function listPacks() {\n  const out = [];\n  for (const [id, p] of Object.entries(PACKS)) {\n    const errs = validatePack(p);\n    if (errs.length) { console.warn(`skipping invalid pack ${id}: ${errs.join('; ')}`); continue; }\n    out.push({\n      id, name: p.name, theme: p.theme, theme_fa: p.theme_fa || p.theme,\n      min_players: p.min_players, max_players: p.max_players,\n    });\n  }\n  return out;\n}\n\nexport function getPack(id) {\n  const p = PACKS[id];\n  if (!p) throw new Error(`pack not found: ${id}`);\n  const errs = validatePack(p);\n  if (errs.length) throw new Error(`pack ${id} invalid: ${errs.join('; ')}`);\n  return p;\n}\n\n// The concrete setup for a team of n: active rooms, timer, and the secret digits.\nexport function getVariant(pack, n) {\n  const v = pack.variants?.[n];\n  if (!v) throw new Error(`no variant for ${n} players`);\n  return {\n    capacity: n,\n    rooms: v.rooms,\n    minutes: v.minutes,\n    digits: v.rooms.flatMap((r) => pack.rooms[r].digits), // SECRET — server only\n  };\n}\n\nexport const stripScene = (scene, active) => ({\n  name_fa: scene.name_fa,\n  image: scene.image,\n  bg: scene.bg,\n  // hide doors that lead to rooms inactive for this team size\n  hotspots: (scene.hotspots ?? []).filter((h) => h.type !== 'door' || h.to === 'lobby' || active.includes(h.to)),\n});\n\n// What the Mini App may see: scenes + hotspots + clue content. Never the digits.\nexport function publicView(pack, n) {\n  const v = getVariant(pack, n);\n  const scenes = { lobby: stripScene(pack.lobby, v.rooms) };\n  for (const id of v.rooms) scenes[id] = stripScene(pack.rooms[id], v.rooms);\n  return { name: pack.name, minutes: v.minutes, lockLength: n, scenes };\n}",
    "lib/packs/index": "// Register each pack here (no filesystem at runtime).\nimport hospital from './hospital.js';\n\nexport const PACKS = { hospital };",
    "lib/presence": "import { db } from 'sdk';\nimport { eq, and, gt } from 'sdk/db';\nimport { matches, matchPlayers } from '../schema.js';\nimport { acquireLock } from './core.js';\nimport { setStatus } from './matches.js';\nimport { refreshCard } from './cards.js';\nimport { send, tryApi } from './tg.js';\n\nconst STALE_MS = 2 * 60 * 1000; // بازیکنی که این مدت poll نکرده «رفته» حساب می‌شه\nconst GRACE_MS = 5 * 60 * 1000; // به بازیکن‌ها وقت می‌دیم بعد از شروع مچ وارد بشن\n\n// cron نداریم؛ از handlerها (با احتمال p) صدا زده می‌شه.\nexport async function closeAbandoned(p = 0.2) {\n  if (Math.random() >= p) return;\n  try {\n    const running = await db.select().from(matches).where(eq(matches.status, 'running')).all();\n    const now = Date.now();\n    for (const m of running) {\n      const started = m.startedAt ? new Date(m.startedAt).getTime() : 0;\n      if (now - started < GRACE_MS) continue;\n      const alive = await db.$count(matchPlayers, and(\n        eq(matchPlayers.matchId, m.id), eq(matchPlayers.isActive, true),\n        gt(matchPlayers.lastSeen, now - STALE_MS),\n      ));\n      if (alive) continue;\n      let release;\n      try { release = await acquireLock(`match:${m.id}`, 3000); } catch { continue; }\n      try {\n        await setStatus(m.id, 'cancelled');\n        await tryApi(() => refreshCard(m.id), 'abandon card');\n        await tryApi(() => send(m.groupId, '🚪 همه از بازی خارج شدن؛ مچ بسته شد.'), 'abandon msg');\n      } finally { await release(); }\n    }\n  } catch (e) {\n    console.warn('closeAbandoned failed', e.message);\n  }\n}",
    "lib/testapp": "import { api } from 'sdk';\nimport { send } from './tg.js';\nimport { MINIAPP_SHORT_NAME } from './gate.js';\n\n// TEMPORARY: connectivity test for opening the Mini App from a group.\n// Uses a direct t.me link (works in any chat); start_param allows [A-Za-z0-9_-], max 64 chars.\nexport async function testapp(msg) {\n  const me = await api.getMe();\n\n  // Main Mini App link needs the Main Mini App to be configured in @BotFather.\n  if (!MINIAPP_SHORT_NAME && !me.has_main_web_app) {\n    return send(msg.chat.id, [\n      '⚠️ <b>مینی‌اپ اصلی ربات تنظیم نشده</b>',\n      'توی @BotFather: ربات ← Bot Settings ← Configure Mini App',\n      'و آدرسی که <code>npx tgcloud push</code> چاپ کرد رو بده.',\n      'یا با /newapp یه مینی‌اپ بساز و short name رو توی <code>lib/gate.js</code> بنویس.',\n    ].join('\\n'));\n  }\n\n  const base = MINIAPP_SHORT_NAME\n    ? `https://t.me/${me.username}/${MINIAPP_SHORT_NAME}`\n    : `https://t.me/${me.username}`;\n  const link = `${base}?startapp=test_${msg.chat.id}`;\n  console.log('miniapp link', link);\n  return send(msg.chat.id, '🧪 <b>تست مینی‌اپ</b>\\nروی دکمه بزن تا مینی‌اپ باز بشه', {\n    reply_to_message_id: msg.message_id,\n    reply_markup: { inline_keyboard: [[{ text: '🚀 باز کردن مینی‌اپ', url: link }]] },\n  });\n}",
    "lib/users": "import { db } from 'sdk';\nimport { eq, desc } from 'sdk/db';\nimport { users } from '../schema.js';\nimport { first } from './core.js';\n\nexport function titleFor(xp) {\n  if (xp <= 100) return 'تازه‌وارد';\n  if (xp <= 500) return 'کاوشگر';\n  if (xp <= 2000) return 'استاد قفل';\n  return 'افسانه فرار';\n}\n\nexport async function upsertUser(from) {\n  const vals = { username: from.username ?? null, firstName: from.first_name ?? null };\n  const res = await db.insert(users)\n    .values({ tgId: from.id, ...vals })\n    .onConflictDoUpdate({ target: users.tgId, set: vals })\n    .returning()\n    .run();\n  return first(res);\n}\n\nexport const getUserByTgId = (tgId) => db.select().from(users).where(eq(users.tgId, tgId)).get();\nexport const topUsers = (n = 20) => db.select().from(users).orderBy(desc(users.totalXp)).limit(n).all();\n\nexport function nextTitle(xp) {\n  if (xp <= 100) return { title: 'کاوشگر', left: 101 - xp };\n  if (xp <= 500) return { title: 'استاد قفل', left: 501 - xp };\n  if (xp <= 2000) return { title: 'افسانه فرار', left: 2001 - xp };\n  return null;\n}\n",
    "lib/wizard": "import { rid, escapeHtml } from './core.js';\nimport { send, editText, EMPTY_KB } from './tg.js';\nimport { fsmKey, loadState, saveState, clearState } from './fsm.js';\nimport { listPacks, getPack, getVariant } from './packLoader.js';\nimport { validCapacities } from './capacity.js';\nimport { createMatch, findOpenByGroup } from './matches.js';\nimport { postMatchCard } from './cards.js';\nimport { isChatAdmin } from './gate.js';\n\nconst kb = (rows) => ({ inline_keyboard: rows });\nconst cancelBtn = (sid) => ({ text: '❌ انصراف', callback_data: `nm:cancel:${sid}` });\n\nfunction packStep(sid) {\n  const packs = listPacks();\n  const rows = packs.map((p) => [{ text: p.name, callback_data: `nm:pack:${p.id}:${sid}` }]);\n  rows.push([{ text: '🔄 رفرش', callback_data: `nm:refresh:${sid}` }, cancelBtn(sid)]);\n  return { text: packs.length ? '📦 <b>یه پک انتخاب کن:</b>' : '😕 هیچ پکی پیدا نشد.', reply_markup: kb(rows) };\n}\n\n// Entry: /newmatch message\nexport async function begin(message) {\n  const state = { sid: rid(), step: 'pack' };\n  await saveState(fsmKey(message.chat.id, message.from.id), state);\n  const { text, reply_markup } = packStep(state.sid);\n  return send(message.chat.id, text,{ reply_to_message_id: message.message_id,\n    reply_markup,});\n}\n\nasync function onPack(c, s, packId) {\n  const pack = getPack(packId);\n  Object.assign(s, { step: 'cap', packId });\n  await saveState(c.key, s);\n  // NOTE: pack thumbnail skipped (not part of required pack fields).\n  const caps = validCapacities(pack).map((n) => ({ text: String(n), callback_data: `nm:cap:${n}:${s.sid}` }));\n  return editText(c.chatId, c.messageId, `📦 <b>${escapeHtml(pack.name)}</b>\\n\\n👥 <b>ظرفیت مچ رو انتخاب کن:</b>`, kb([caps, [cancelBtn(s.sid)]]));\n}\n\nasync function onCap(c, s, n) {\n  const pack = getPack(s.packId);\n  if (!validCapacities(pack).includes(n)) return;\n  const variant = getVariant(pack, n);\n  Object.assign(s, { step: 'confirm', capacity: n });\n  await saveState(c.key, s);\n  const text = [\n    '📋 <b>خلاصه‌ی مچ</b>',\n    '━━━━━━━━━━━━━━',\n    `📦 پک: ${escapeHtml(pack.name)}`,\n    `🎭 تم: ${escapeHtml(pack.theme_fa || pack.theme)}`,\n    `👥 ظرفیت: ${n} نفر`,\n    `🚪 تعداد اتاق: ${variant.rooms.length}`,\n    `🔢 طول رمز: ${n} رقم`,\n    `⏱ زمان: ${variant.minutes} دقیقه`,\n  ].join('\\n');\n  return editText(c.chatId, c.messageId, text, kb([[\n    { text: '✅ شروع ثبت‌نام', callback_data: `nm:confirm:${s.sid}` }, cancelBtn(s.sid),\n  ]]));\n}\n\nasync function onConfirm(c, s) {\n  if (await findOpenByGroup(c.chatId)) {\n    return editText(c.chatId, c.messageId, '⚠️ یه مچ باز داری؛ اول اون رو تموم یا لغو کن', EMPTY_KB);\n  }\n  const match = await createMatch({\n    groupId: c.chatId, packId: s.packId, maxPlayers: s.capacity, createdBy: c.from.id,\n  });\n  await postMatchCard(match.id);\n  await clearState(c.key);\n  return editText(c.chatId, c.messageId, '🎉 مچ ساخته شد! ثبت‌نام رو توی پیام پین‌شده ببین', EMPTY_KB);\n}\n\n// c = { chatId, messageId, from }; parts = data.split(':') => nm:<action>:<args...>:<sid>\nexport async function handleWizard(c, parts) {\n  if (!(await isChatAdmin(c.chatId, c.from.id))) return;\n  const [, action, ...rest] = parts;\n  const sid = rest.pop();\n  c.key = fsmKey(c.chatId, c.from.id);\n  const s = await loadState(c.key);\n  if (!s || s.sid !== sid) {\n    return editText(c.chatId, c.messageId, '⌛ زمان این مرحله تموم شد؛ دوباره /newmatch بزن', EMPTY_KB);\n  }\n  await saveState(c.key, s); // refresh TTL\n  if (action === 'cancel') { await clearState(c.key); return editText(c.chatId, c.messageId, '❌ لغو شد', EMPTY_KB); }\n  if (action === 'refresh') {\n    const { text, reply_markup } = packStep(sid);\n    return editText(c.chatId, c.messageId, text, reply_markup);\n  }\n  if (action === 'pack') return onPack(c, s, rest[0]);\n  if (action === 'cap') return onCap(c, s, Number(rest[0]));\n  if (action === 'confirm') return onConfirm(c, s);\n}\n",
    "handlers/callback_query": "import { api } from 'sdk';\nimport { handleWizard } from '../lib/wizard.js';\nimport { handleMatchAction } from '../lib/matchActions.js';\nimport { sendProfileByTgId } from '../lib/commands.js';\nimport { tryApi } from '../lib/tg.js';\nimport { isChannelMember, JOIN_TEXT } from '../lib/gate.js';\n\nconst ROUTES = [\n  [/^nm:(pack|cap|confirm|cancel|refresh):/, (c, d) => handleWizard(c, d.split(':'))],\n  [/^match:(join|leave|start):(\\d+)$/, (c, d, m) => handleMatchAction(c, m[1], Number(m[2]))],\n  [/^profile:view:(\\d+)$/, (c, d, m) => sendProfileByTgId(c.chatId, Number(m[1]))],\n];\n\nexport default async function (cq) {\n  if (!(await isChannelMember(cq.from.id))){\n    return tryApi(() => api.answerCallbackQuery({\n      callback_query_id: cq.id, text:JOIN_TEXT, show_alert:true,\n    }), 'gate alert');\n  }\n  await tryApi(() => api.answerCallbackQuery({ callback_query_id: cq.id}), 'answer');\n  const data = cq.data || '';\n  const c = { chatId: cq.message?.chat?.id, messageId: cq.message?.message_id, from: cq.from };\n  for (const [re, handler] of ROUTES) {\n    const m = data.match(re);\n    if (!m) continue;\n    try {\n      return await handler(c, data, m);\n    } catch (e) {\n      console.error('callback failed', data, e);\n      // NOTE: query already answered, so this alert may be ignored by Telegram.\n      return tryApi(() => api.answerCallbackQuery({\n        callback_query_id: cq.id, text: 'خطا، دوباره تلاش کن', show_alert: true,\n      }), 'error alert');\n    }\n  }\n}\n",
    "handlers/message": "import { api } from 'sdk';\nimport { COMMANDS } from '../lib/commands.js';\nimport { send, tryApi } from '../lib/tg.js';\nimport { isChannelMember, JOIN_TEXT, joinKeyboard } from '../lib/gate.js';\nimport { isAnonymousAdmin } from '../lib/gate.js';\n\nexport default async function (message) {\n  const PUBLIC = new Set(['start', 'help']);\n  const m = (message.text || '').match(/^\\/(\\w+)(?:@(\\w+))?(?:\\s|$)/);\n  if (!m) return;\n  const cmd = COMMANDS[m[1].toLowerCase()];\n  if (!cmd) return;\n  try {\n    // In groups the command must be addressed to this bot (/cmd@botname).\n    if (message.chat.type !== 'private') {\n      if (!m[2]) return;\n      const me = await api.getMe();\n      if (me.username.toLowerCase() !== m[2].toLowerCase()) return;\n    }\n    if (!isAnonymousAdmin(message) && !(await isChannelMember(message.from.id))) {\n      return await send(message.chat.id, JOIN_TEXT, { reply_markup: joinKeyboard() });\n    }\n    await cmd(message);\n  } catch (e) {\n    console.error('command failed', m[1], e);\n    await tryApi(() => send(message.chat.id, '⚠️ مشکلی پیش اومد، دوباره امتحان کن'), 'error reply');\n  }\n  if (!PUBLIC.has(m[1].toLowerCase()) &&\n  !isAnonymousAdmin(message) &&\n  !(await isChannelMember(message.from.id))) {\n    return await send(message.chat.id, JOIN_TEXT, { reply_markup: joinKeyboard() });\n  }\n}",
    "endpoints/act": "import { EndpointError } from 'sdk';\nimport { requireAnyPlayer } from '../lib/gameApi.js';\nimport { playerAct } from '../lib/game.js';\nimport { snapshotWithEnd, settle } from '../lib/finish.js';\n\nexport default async function (input, ctx) {\n  const { match, user } = await requireAnyPlayer(ctx);\n  if (match.status !== 'running') throw new EndpointError('🏁 بازی تموم شده!', { code: 'FINISHED' });\n  // Lazy deadline check before mutating state.\n  await settle(match);\n  const room = typeof input.room === 'string' ? input.room : '';\n  const object = typeof input.object === 'string' ? input.object : '';\n  const withItem = typeof input.with === 'string' ? input.with : null;\n  const out = await playerAct(match, user, room, object, withItem);\n  if (out.busy) throw new EndpointError('⏳ یه لحظه صبر کن و دوباره بزن', { code: 'BUSY' });\n  return { result: out.result, game: await snapshotWithEnd(match, user) };\n}\n",
    "endpoints/getGame": "import { EndpointError } from 'sdk';\nimport { requireAnyPlayer } from '../lib/gameApi.js';\nimport { snapshotWithEnd, settle } from '../lib/finish.js';\nimport { closeAbandoned } from '../lib/presence.js';\n\nexport default async function (input, ctx) {\n  const { match, user } = await requireAnyPlayer(ctx);\n  // Lazy deadline check: if the timer ran out, this very poll concludes the match.\n  if (match.status === 'running') await settle(match);\n  closeAbandoned(); // fire-and-forget: no player around for 2 min → cancel the match\n  const snap = await snapshotWithEnd(match, user);\n  if (!snap) return { notReady: true };\n  if (Number.isInteger(input.seq) && input.seq === snap.seq) return { unchanged: true };\n  return snap;\n}\n",
    "lib/core": "// Shared low-level core: formatting helpers, the game_state row (one per match),\n// the DB-backed mutex, and the opportunistic sweep that replaces a cron job.\nimport { db } from 'sdk';\nimport { eq } from 'sdk/db';\nimport { gameState } from '../schema.js';\n\n// ---- small helpers (were lib/util.js) --------------------------------------------------------\nconst MAP = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' };\nexport const escapeHtml = (str) => String(str ?? '').replace(/[&<>\"']/g, (c) => MAP[c]);\n\nexport const formatDate = (d) =>\n  new Intl.DateTimeFormat('fa-IR', { dateStyle: 'medium' }).format(new Date(d));\n\nexport const rid = () => Math.random().toString(36).slice(2, 10);\n\n// NOTE: docs show both array and {rows} shapes for .returning().run(); handle both.\nexport const first = (res) => (Array.isArray(res) ? res[0] : res?.rows?.[0]);\n\n// ---- game_state rows (were lib/gameState.js) -------------------------------------------------\nexport const getGame = (matchId) => db.select().from(gameState).where(eq(gameState.matchId, matchId)).get();\n\nexport const createGame = (matchId, state) =>\n  db.insert(gameState).values({ matchId, state: JSON.stringify(state) })\n    .onConflictDoNothing({ target: gameState.matchId }).run();\n\n// patch: { state?: string, finished?: string }\nexport const saveGame = (matchId, patch) =>\n  db.update(gameState).set({ ...patch, updatedAt: new Date() }).where(eq(gameState.matchId, matchId)).run();\n\n// ---- cleanup (were lib/cleanup.js) -----------------------------------------------------------\n// No cron on the platform, so expired rows are swept opportunistically:\n// roughly once every 1/p calls of saveState / acquireLock.\nexport async function maybeSweep(p = 0.05) {\n  if (Math.random() >= p) return;\n  const now = Date.now();\n  try {\n    await db.run('DELETE FROM fsm_sessions WHERE expires_at < :now', { ':now': now });\n    await db.run('DELETE FROM locks WHERE expires_at < :now', { ':now': now });\n  } catch (e) {\n    console.warn('sweep failed', e.message);\n  }\n}\n\n// ---- locks (were lib/lock.js) ----------------------------------------------------------------\n// DB-backed lock (replaces Redis SET NX PX). Returns a release function or throws 'LOCKED'.\nexport async function acquireLock(id, ttlMs = 3000) {\n  await maybeSweep(); // clears expired locks/sessions of every id, not just this one\n  const now = Date.now();\n  const token = rid();\n  await db.run('DELETE FROM locks WHERE id = :id AND expires_at < :now', { ':id': id, ':now': now });\n  const r = await db.run(\n    'INSERT OR IGNORE INTO locks (id, token, expires_at) VALUES (:id, :token, :exp)',\n    { ':id': id, ':token': token, ':exp': now + ttlMs },\n  );\n  if (!r.rowsAffected) throw new Error('LOCKED');\n  return () => db.run('DELETE FROM locks WHERE id = :id AND token = :token', { ':id': id, ':token': token });\n}\n",
    "lib/finish": "// End-of-match cycle: the exit-lock code, the countdown timer, win/lose settlement,\n// per-player ranking (from match_events), XP rewards and the group announcement.\n//\n// There is no cron on this platform, so everything is lazy: getGame / act / submitCode\n// call settle() first — if the variant's minutes elapsed, the match is finished before\n// answering that request. The game_state row stays alive after finishing: it carries the\n// end screen (gs.finished) which snapshot() merges into every response.\n\nimport { db } from 'sdk';\nimport { eq, and, asc, sql } from 'sdk/db';\nimport { matchEvents, matchPlayers, users } from '../schema.js';\nimport { acquireLock } from './core.js';\nimport { getMatch, setStatus } from './matches.js';\nimport { getPack, getVariant } from './packLoader.js';\nimport { getGame, saveGame } from './core.js';\nimport { buildSnapshot } from './snapshot.js';\nimport { listActive } from './players.js';\nimport { refreshCard } from './cards.js';\nimport { send, tryApi } from './tg.js';\nimport { escapeHtml } from './core.js';\n\nconst FA = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];\nexport const faDigits = (str) => String(str).replace(/\\d/g, (d) => FA[+d]);\n\n// Persian/French digits, spaces, dashes → plain ASCII digit string.\nexport const parseCode = (raw) => {\n  let out = '';\n  for (const ch of String(raw ?? '')) {\n    if (ch >= '0' && ch <= '9') out += ch;\n    else {\n      const i = FA.indexOf(ch);\n      if (i >= 0) out += i;\n    }\n  }\n  return out;\n};\n\n// Wrong-code cooldown, computed from the event log itself (no extra state): a player who\n// made ≥3 wrong attempts in the last minute must wait until the oldest one ages out.\nconst COOLDOWN_MS = 60 * 1000; // 60s\nconst MAX_WRONG = 3;\n\n// ---- scoring ---------------------------------------------------------------------------\n// rank 1..n by the time of the player's FIRST correct code (players with none rank last,\n// ordered by join time). score = 1000 + 150*(n-rank) + 5*correct − 2*wrong, floored at 0.\n// xp = score (win) or floor(score/4) (loss).\nexport function computeRanks(rows, events) {\n  const n = rows.length || 1;\n  const ok = new Map(); // userId -> first correct ts\n  const bad = new Map(); // userId -> wrong count\n  for (const e of events) {\n    if (e.type === 'digit_ok') {\n      const t = e.createdAt.getTime();\n      const cur = ok.get(e.userId);\n      if (cur === undefined || t < cur) ok.set(e.userId, t);\n    } else if (e.type === 'digit_wrong') {\n      bad.set(e.userId, (bad.get(e.userId) || 0) + 1);\n    }\n  }\n  const ranked = [...rows].sort((a, b) => {\n    const ta = ok.has(a.userId) ? ok.get(a.userId) : Infinity;\n    const tb = ok.has(b.userId) ? ok.get(b.userId) : Infinity;\n    if (ta !== tb) return ta - tb;\n    return new Date(a.joinedAt) - new Date(b.joinedAt);\n  });\n  return ranked.map((row, i) => {\n    const rank = i + 1;\n    const good = events.filter((e) => e.userId === row.userId && e.type === 'digit_ok').length;\n    const wrong = bad.get(row.userId) || 0;\n    const score = Math.max(0, 1000 + 150 * (n - rank) + 5 * good - 2 * wrong);\n    return { ...row, rank, score };\n  });\n}\n\n// PURE (no sdk/DB): the exit-lock keypad state the Mini App renders. `found` are the\n// digits the team has discovered (already in the snapshot — public); `slots` shows which\n// cells the log has filled (first-correct-wins per cell); `cooldownMs` is how long this\n// player must still wait after ≥3 recent wrong attempts.\nexport function lockState(variantDigits, found, events, userId, now) {\n  const len = variantDigits.length;\n  const slots = Array(len).fill(null);\n  let myWrong = [];\n  for (const e of events) {\n    // The keypad logs the whole submitted code in `digit` and which lock cell it filled\n    // in `slot`. A correct code is a permutation of the digits, so each single-digit\n    // event fills its own cell (the cell order carries no meaning — any order wins).\n    if (e.type === 'digit_ok' && e.slot !== null && e.slot !== undefined && e.slot < len && slots[e.slot] === null) {\n      const s = String(e.digit ?? '');\n      slots[e.slot] = faDigits(s.length === 1 ? s : s.slice(-len));\n    } else if (e.type === 'digit_wrong' && e.userId === userId) {\n      myWrong.push(e.createdAt.getTime());\n    }\n  }\n  myWrong.sort((a, b) => a - b);\n  let cooldownMs = 0;\n  if (myWrong.length >= MAX_WRONG) {\n    const cutoff = now - COOLDOWN_MS;\n    myWrong = myWrong.filter((t) => t >= cutoff);\n    if (myWrong.length >= MAX_WRONG) cooldownMs = myWrong[0] + COOLDOWN_MS - now;\n  }\n  return { lockLength: len, slots, found: found.map(faDigits), cooldownMs: Math.max(0, cooldownMs) };\n}\n\nasync function writeResults(ranked, won) {\n  for (const p of ranked) {\n    const xp = won ? p.score : Math.floor(p.score / 4);\n    await db.update(matchPlayers).set({ rank: p.rank, score: p.score })\n      .where(eq(matchPlayers.id, p.id)).run();\n    // Incremental update via the sql template (column refs interpolate as identifiers).\n    await db.update(users)\n      .set({\n        totalXp: sql`${users.totalXp} + ${xp}`,\n        matchesPlayed: sql`${users.matchesPlayed} + 1`,\n        matchesWon: sql`${users.matchesWon} + ${won ? 1 : 0}`,\n      })\n      .where(eq(users.id, p.userId)).run();\n  }\n}\n\n// Announce + end screen + DB close-out. Runs under the match lock, exactly once.\nasync function conclude(match, won, reasonText) {\n  const pack = getPack(match.packId);\n  // listActive returns users (with usernames) ordered by join time, already joined\n  // against match_players — we add the row ids from a parallel raw query.\n  const rows = await db.select().from(matchPlayers)\n    .where(and(eq(matchPlayers.matchId, match.id), eq(matchPlayers.isActive, true)))\n    .orderBy(asc(matchPlayers.joinedAt), asc(matchPlayers.id)).all();\n  const people = await listActive(match.id);\n  const byUserId = new Map(people.map((u) => [u.id, u]));\n  const events = await db.select().from(matchEvents).where(eq(matchEvents.matchId, match.id)).all();\n  const ranked = computeRanks(rows, events).map((p) => {\n    const u = byUserId.get(p.userId);\n    return { ...p, name: u ? (u.username ? `@${u.username}` : u.firstName || 'بازیکن') : 'بازیکن' };\n  });\n  await writeResults(ranked, won);\n  await setStatus(match.id, 'finished');\n\n  const digits = getVariant(pack, match.maxPlayers).digits.join('');\n  const lines = [\n    won ? '🎉 <b>فرار موفق!</b>' : '💀 <b>وقت تموم شد — فرار ناموفق</b>',\n    `🔑 رمز قفل: <b>${escapeHtml(faDigits(digits))}</b>`,\n    '',\n    '🏆 <b>رتبه‌بندی</b>',\n    ...ranked.map((p) => `${FA[p.rank] ?? p.rank}. ${escapeHtml(p.name)} — +${p.score} XP`),\n  ];\n  await tryApi(() => send(match.groupId, lines.join('\\n')), 'finish announce');\n  await tryApi(() => refreshCard(match.id), 'finish card');\n\n  const end = {\n    won,\n    title: won ? '🎉 فرار موفق!' : '⏰ وقت تموم شد',\n    subtitle: reasonText || (won ? 'با هم فرار کردید!' : 'رمز درست را نزديد.'),\n    digits: faDigits(digits),\n    players: ranked.map((p) => ({ rank: p.rank, name: p.name, score: p.score })),\n  };\n  await saveGame(match.id, { finished: JSON.stringify(end) });\n  return end;\n}\n\n// Lazy deadline check, called (after requirePlayer) by getGame/act/submitCode.\n// Returns the end screen if it just concluded, else null. Cheap when not expired.\nexport async function settle(match) {\n  const g = await getGame(match.id);\n  if (!g) return null;\n  const started = match.startedAt ? new Date(match.startedAt).getTime() : 0;\n  const minutes = getVariant(getPack(match.packId), match.maxPlayers).minutes;\n  if (!started || Date.now() - started < minutes * 60_000) return null;\n  let release;\n  try { release = await acquireLock(`match:${match.id}`, 5000); } catch { return null; }\n  try {\n    const fresh = await getMatch(match.id);\n    if (fresh.status !== 'running') return null;\n    return conclude(fresh, false, 'زمان بازی تمام شد.');\n  } finally { await release(); }\n}\n\n// The Mini App's exit-lock keypad. A correct submission must contain ALL the team's\n// digits in any order (the lock cells show no order hint). Wrong attempts are logged\n// and rate-limited per player; a correct one concludes the match exactly once.\nexport async function submitCode(match, user, rawCode) {\n  const code = parseCode(rawCode);\n  if (!code) return { result: { ok: false, text: '🔢 اول رقم‌ها رو وارد کن' } };\n\n  const pack = getPack(match.packId);\n  const variant = getVariant(pack, match.maxPlayers);\n  const now = Date.now();\n\n  // Cooldown lives on the whole TEAM (one shared lock): ≥3 wrong attempts by anyone\n  // within the last minute → everyone waits until the oldest of them ages out.\n  const allEvents = await db.select().from(matchEvents).where(eq(matchEvents.matchId, match.id)).all();\n  const st = lockState(variant.digits, [], allEvents, user.id, now);\n  const myWrong = allEvents\n    .filter((e) => e.type === 'digit_wrong')\n    .map((e) => e.createdAt.getTime())\n    .sort((a, b) => a - b)\n    .filter((t) => now - t < COOLDOWN_MS);\n  if (myWrong.length >= MAX_WRONG) {\n    const wait = Math.ceil((COOLDOWN_MS - (now - myWrong[0])) / 1000);\n    return { result: { ok: false, text: `🚫 زیاد اشتباه زدید! ${wait} ثانیه صبر کن` } };\n  }\n\n  const sorted = (s) => [...s].sort().join('');\n  const correct = code.length === variant.digits.length\n    && sorted(code) === sorted(variant.digits.join(''));\n\n  // Log the attempt. A correct one fills the first still-empty lock cell; the unique\n  // (match_id, slot) index settles simultaneous winners (the loser logs without a slot).\n  const usedSlots = new Set(allEvents\n    .filter((e) => e.type === 'digit_ok' && e.slot !== null && e.slot !== undefined)\n    .map((e) => e.slot));\n  let slot = null;\n  if (correct) {\n    for (let i = 0; i < variant.digits.length; i++) if (!usedSlots.has(i)) { slot = i; break; }\n  }\n  try {\n    await db.insert(matchEvents)\n      .values({\n        matchId: match.id, userId: user.id,\n        type: correct ? 'digit_ok' : 'digit_wrong',\n        digit: Number(code), slot, createdAt: new Date(),\n      }).run();\n  } catch { /* lost the slot race — the attempt still counts as logged */ }\n\n  if (!correct) {\n    return { result: { ok: false, text: '❌ رمز اشتباهه! رقم‌ها رو با هم چک کن و دوباره بزن' } };\n  }\n\n  // Correct code → finish under the match lock (conclude runs exactly once).\n  let release;\n  try { release = await acquireLock(`match:${match.id}`, 5000); } catch { release = async () => {}; }\n  let end;\n  try {\n    const fresh = await getMatch(match.id);\n    if (fresh.status !== 'running') {\n      const g = await getGame(match.id);\n      end = g?.finished ? JSON.parse(g.finished) : null;\n    } else {\n      end = await conclude(fresh, true, `${user.firstName || 'یکی از بازیکن‌ها'} رمز درست رو زد!`);\n    }\n  } finally { await release(); }\n\n  return { result: { ok: true, text: '🔓 قفل باز شد!' }, end };\n}\n\n// Snapshot that tolerates a finished match: the game_state row keeps the end screen,\n// so players who still poll see the result instead of an error. Also carries the\n// countdown (`deadline`) and the exit-lock keypad state (`lock`).\nexport async function snapshotWithEnd(match, user) {\n  const g = await getGame(match.id);\n  if (!g) return null;\n  const pack = getPack(match.packId);\n  const variant = getVariant(pack, match.maxPlayers);\n  const gs = JSON.parse(g.state);\n  const snap = buildSnapshot(pack, variant.rooms, gs, match.maxPlayers);\n  if (g.finished) {\n    snap.end = JSON.parse(g.finished);\n    return snap;\n  }\n  const started = match.startedAt ? new Date(match.startedAt).getTime() : Date.now();\n  snap.deadline = started + variant.minutes * 60_000;\n  const events = await db.select().from(matchEvents).where(eq(matchEvents.matchId, match.id)).all();\n  snap.lock = lockState(variant.digits, snap.found, events, user.id, Date.now());\n  return snap;\n}\n",
    "lib/gate": "// Everything about WHO may act: channel gate, chat-admin checks, Mini App link config.\n// (Merged from the old lib/channel.js + lib/admin.js + lib/config.js.)\nimport { api } from 'sdk';\n\n// Short name of the Mini App as registered in @BotFather (/newapp).\n// Leave '' to use the bot's *main* Mini App link: https://t.me/<bot>?startapp=...\nexport const MINIAPP_SHORT_NAME = 'escapist';\n\n// ---- channel gate -------------------------------------------------------------------------------\nexport const CHANNEL = '@escapist1b';\nexport const CHANNEL_URL = 'https://t.me/escapist1b';\n\nconst OK = ['creator', 'administrator', 'member'];\n\nexport async function isChannelMember(userId) {\n  try {\n    const m = await api.getChatMember({ chat_id: CHANNEL, user_id: userId });\n    return OK.includes(m.status) || (m.status === 'restricted' && m.is_member === true);\n  } catch (e) {\n    const d = String(e.description || e.message || '');\n    if (/user not found/i.test(d)) return false;\n    console.error('channel check failed (check CHANNEL & bot admin):', d);\n    return true;\n  }\n}\n\nexport const JOIN_TEXT = '📢 برای استفاده از ربات اول باید عضو کانال ما بشی، بعد دوباره امتحان کن';\nexport const joinKeyboard = () => ({\n  inline_keyboard: [[{ text: '📢 عضویت در کانال', url: CHANNEL_URL }]],\n});\n\n// ---- admins -------------------------------------------------------------------------------------\n// True if the user is creator/administrator of the chat.\nexport async function isChatAdmin(chatId, userId) {\n  try {\n    const m = await api.getChatMember({ chat_id: chatId, user_id: userId });\n    return ['creator', 'administrator'].includes(m.status);\n  } catch (e) {\n    console.warn('getChatMember failed', e.description || e.message);\n    return false;\n  }\n}\n\n// Anonymous admins post as the group itself (sender_chat.id === chat.id).\nexport const isAnonymousAdmin = (msg) => msg.sender_chat?.id === msg.chat.id;\n\nexport const isGroup = (chat) => ['group', 'supergroup'].includes(chat.type);\n\nexport async function isAdminMessage(msg) {\n  return isAnonymousAdmin(msg) || (await isChatAdmin(msg.chat.id, msg.from.id));\n}\n",
    "lib/packs/hospital/lobby": "export default {\n  id: \"lobby\",\n  views: {\n    lobby: {\"image\":\"/dist/pack1/lobby/Gemini_Generated_Image_ngbl2tngbl2tngbl.jpg\"},\n  },\n  objects: {\n    officedoor: {\"view\":\"lobby\",\"x\":84.5,\"y\":17.1,\"w\":10.4,\"h\":80.7,\"action\":\"goto\",\"to\":\"office\"},\n    powerdoor: {\"view\":\"lobby\",\"x\":72.2,\"y\":28.9,\"w\":6.6,\"h\":49.2,\"action\":\"goto\",\"to\":\"main\"},\n    libdoor: {\"view\":\"lobby\",\"x\":23,\"y\":30,\"w\":6,\"h\":46.6,\"action\":\"goto\",\"to\":\"library\"},\n    serdoor: {\"view\":\"lobby\",\"x\":4.7,\"y\":22.9,\"w\":11.4,\"h\":67.1,\"action\":\"goto\",\"to\":\"sergery\"},\n    back: {\"view\":\"lobby\",\"x\":44.5,\"y\":82.9,\"w\":11.3,\"h\":17.1,\"action\":\"goto\",\"image\":\"/dist/pack1/lobby/Ornate Crimson Fantasy Back Arrow.png\",\"to\":\"locklobby\"},\n    morguest: {\"view\":\"lobby\",\"x\":30.3,\"y\":11.2,\"w\":8.1,\"h\":49.1,\"action\":\"goto\",\"to\":\"morgue\"},\n    waitingdoor: {\"view\":\"lobby\",\"x\":44,\"y\":37.6,\"w\":16.3,\"h\":21.8,\"action\":\"goto\",\"to\":\"waiting\"},\n  },\n};\n",
    "lib/rules": "// Data-only rule interpreter. PURE: no sdk, no DB, no clock, no randomness, no eval.\n//\n// A rule lives in `rules: []` of an object, a view (views[name].rules) or a room (room.rules):\n//   { on, if?: [checks that must ALL pass], do?: [effects], else?: [effects] }\n//\n// on (trigger):  'click' | 'use:<item>' | 'enter' | 'state:<obj>[=<state>]' | 'flag:<name>' | 'solved[:<room>]'\n//   click / use  -> only on object rules      enter -> only on view / room rules\n//   state / flag / solved -> anywhere (this is how effects chain into other rules, across rooms)\n// refs: a bare id means \"this room\"; \"room:id\" reaches another room.\n// checks: {state:obj, is|isnt} {done:[obj..]} {has:item} {using:item|false} {holding:true}\n//         {solved:room} {flag:name, is|isnt|gte|lte} {view:name}\n// effects: {set:obj,to} {show:obj} {hide:obj} {image:obj,to} {bg:view,to} {give:item} {take:item}\n//          {audio:path} {say:text,to:'actor'|'team',bad?,audio?} {read:{text?,image?}} {goto:view}\n//          {flag:name,set|inc} {digit:room} {solve:room} {stop:true}   (stop = ends this trigger's rule list)\n//\n// Legacy object fields (action/requires/sets/setState/accepts/item/hidden/decoy/text/failText/doneText/\n// audio/images/labels, room.win) are compiled into rules by legacyRules() and run AFTER explicit rules.\n\nexport const MAX_STEPS = 50; // chained events (state/flag/solved) per player action\nexport const ENTER_PREFIX = '@enter:'; // object id the client sends to report \"entered view <name>\"\n\nexport const isDone = (objs, id) => id in objs && !['idle', 'hidden'].includes(objs[id]);\n\nconst norm = (v) => (v === true ? 1 : v === false ? 0 : v);\nexport const ref = (raw, room) => {\n  const s = String(raw);\n  const i = s.indexOf(':');\n  return i < 0 ? { room, id: s } : { room: s.slice(0, i), id: s.slice(i + 1) };\n};\n\n// ---------------------------------------------------------------------------------------------\n// Legacy compiler: reproduces the old act() decision chain as ordered guard rules ({stop} ends it).\nexport function legacyRules(id, o) {\n  if (!o.action) return [];\n  const bad = (text) => [{ say: text, to: 'actor', bad: true }, { stop: true }];\n  if (o.action === 'goto') return [{ on: 'click', do: [{ stop: true }] }];\n  if (o.decoy) return [{ on: 'click', do: bad(o.failText || '❌ هیچ اتفاقی نیفتاد') }];\n\n  const R = [];\n  const repeat = o.action === 'examine' || o.action === 'play';\n  const dText = o.doneText || (repeat ? o.text : '✔️ این کار قبلاً انجام شده');\n  const dAudio = repeat && !o.doneText ? o.audio : undefined;\n  const d = [];\n  if (dText !== undefined || dAudio !== undefined) d.push({ say: dText, to: 'actor', audio: dAudio });\n  d.push({ stop: true });\n  R.push({ on: 'click', if: [{ state: id, isnt: 'idle' }], do: d });\n\n  if ((o.requires || []).length) {\n    R.push({ on: 'click', if: [{ done: o.requires }], else: bad(o.failText || '🔒 هنوز نمی‌تونی این کار رو بکنی') });\n  }\n  if (o.action === 'place') {\n    R.push({ on: 'click', if: [{ using: false }], do: bad('🎒 اول یه آیتم از کوله‌ت انتخاب کن') });\n    R.push({ on: 'click', if: [{ holding: true }], else: bad('🎒 این آیتم رو نداری') });\n    R.push({ on: 'click', if: [{ using: o.accepts }], else: bad(o.failText || '🤔 این اینجا جواب نمی‌ده') });\n  }\n  const fx = [];\n  if (o.action === 'place') fx.push({ take: o.accepts });\n  if (o.action === 'pickup') fx.push({ give: o.item || id });\n  let next = o.setState;\n  if (!next) next = o.action === 'pickup' ? 'taken' : o.action === 'examine' ? (o.sets ? 'done' : null) : 'done';\n  const text = o.text || (o.action === 'pickup' ? '🎒 برداشتی' : '✅');\n  if (!next) fx.push({ say: text, to: 'actor', audio: o.audio });\n  else {\n    fx.push({ set: id, to: next });\n    for (const [k, v] of Object.entries(o.sets || {})) fx.push({ set: k, to: v });\n    fx.push({ say: text, to: 'team', audio: o.audio });\n  }\n  R.push({ on: 'click', do: fx });\n  return R;\n}\n\n// ---------------------------------------------------------------------------------------------\n// Triggers\nfunction parseOn(on) {\n  const s = String(on);\n  if (s === 'click' || s === 'enter' || s === 'solved') return { kind: s };\n  const i = s.indexOf(':');\n  if (i < 0) return null;\n  const kind = s.slice(0, i);\n  const arg = s.slice(i + 1);\n  if (!arg) return null;\n  if (kind === 'use' || kind === 'flag' || kind === 'solved') return { kind, arg };\n  if (kind === 'state') {\n    const j = arg.lastIndexOf('=');\n    return j < 0 ? { kind, arg } : { kind, arg: arg.slice(0, j), val: arg.slice(j + 1) };\n  }\n  return null;\n}\n\nfunction matches(p, ev, rid) {\n  switch (p.kind) {\n    case 'click': return ev.on === 'click';\n    case 'use': return ev.on === 'use' && ev.item === p.arg;\n    case 'enter': return ev.on === 'enter';\n    case 'state': {\n      if (ev.on !== 'state') return false;\n      const r = ref(p.arg, rid);\n      return r.room === ev.room && r.id === ev.obj && (p.val === undefined || p.val === ev.to);\n    }\n    case 'flag': return ev.on === 'flag' && ev.name === p.arg;\n    case 'solved': return ev.on === 'solved' && (p.arg === undefined || p.arg === ev.room);\n    default: return false;\n  }\n}\n\n// ---------------------------------------------------------------------------------------------\n// Interpreter\nclass CascadeError extends Error {}\n\nfunction makeWorld(rooms, gs, by, withItem, view) {\n  const g = JSON.parse(JSON.stringify(gs)); // draft: only committed if the whole run succeeds\n  g.flags ||= {}; g.imgs ||= {}; g.bgs ||= {}; g.shown ||= [];\n  return {\n    rooms, gs: g, by, withItem: withItem || null, view: view || null,\n    queue: [], steps: 0, dirty: false, touched: new Set(), solved: [], n: g.seq + 1,\n    out: { ok: true, msgs: [] }, memo: new Map(),\n  };\n}\n\nfunction objRules(w, rid, oid) {\n  const k = `${rid}:${oid}`;\n  if (!w.memo.has(k)) {\n    const o = w.rooms[rid]?.objects?.[oid];\n    w.memo.set(k, o ? [...(o.rules || []), ...legacyRules(oid, o)] : []);\n  }\n  return w.memo.get(k);\n}\n\nfunction sources(w, ev) {\n  const out = [];\n  const add = (rid, rules) => { for (const r of rules || []) out.push([rid, r]); };\n  if (ev.on === 'click' || ev.on === 'use') add(ev.room, objRules(w, ev.room, ev.obj));\n  else if (ev.on === 'enter') {\n    const rm = w.rooms[ev.room];\n    add(ev.room, rm.rules);\n    add(ev.room, rm.views?.[ev.view]?.rules);\n  } else {\n    for (const [rid, rm] of Object.entries(w.rooms)) {\n      add(rid, rm.rules);\n      for (const v of Object.values(rm.views || {})) add(rid, v.rules);\n      for (const oid of Object.keys(rm.objects || {})) add(rid, objRules(w, rid, oid));\n    }\n  }\n  return out;\n}\n\nconst LEAVES = ['state', 'done', 'has', 'using', 'holding', 'solved', 'flag', 'view'];\n\nfunction holds(w, rid, c) {\n  const g = w.gs;\n  switch (LEAVES.find((k) => k in c)) {\n    case 'state': {\n      const r = ref(c.state, rid);\n      const s = g.objs[r.room]?.[r.id];\n      return 'isnt' in c ? s !== c.isnt : s === c.is;\n    }\n    case 'done': return [].concat(c.done).every((x) => { const r = ref(x, rid); return isDone(g.objs[r.room] || {}, r.id); });\n    case 'has': return g.inv.includes(c.has);\n    case 'using': return c.using === false ? !w.withItem : w.withItem === c.using;\n    case 'holding': return (!!w.withItem && g.inv.includes(w.withItem)) === !!c.holding;\n    case 'solved': return !!g.done[c.solved];\n    case 'flag': {\n      const v = g.flags[c.flag] ?? 0;\n      if ('is' in c) return v === norm(c.is);\n      if ('isnt' in c) return v !== norm(c.isnt);\n      if ('gte' in c) return v >= c.gte;\n      if ('lte' in c) return v <= c.lte;\n      return !!v;\n    }\n    case 'view': return w.view === c.view;\n    default: return false;\n  }\n}\n\nfunction setState(w, r, to) {\n  const objs = w.gs.objs[r.room];\n  if (!objs || !(r.id in objs)) return;\n  w.dirty = true;\n  w.touched.add(r.room);\n  const from = objs[r.id];\n  if (from === to) return;\n  objs[r.id] = to;\n  w.queue.push({ on: 'state', room: r.room, obj: r.id, from, to });\n}\n\nfunction solveRoom(w, room) {\n  if (!w.rooms[room] || w.gs.done[room]) return;\n  w.gs.done[room] = true;\n  w.solved.push(room);\n  w.dirty = true;\n  w.queue.push({ on: 'solved', room });\n}\n\nexport const VERBS = ['stop', 'flag', 'say', 'set', 'show', 'hide', 'image', 'bg', 'give', 'take', 'audio', 'read', 'goto', 'digit', 'solve'];\n\nfunction effect(w, rid, e) {\n  const g = w.gs;\n  const o = w.out;\n  switch (VERBS.find((k) => k in e)) {\n    case 'flag': {\n      const cur = g.flags[e.flag] ?? 0;\n      const next = 'inc' in e ? Number(cur) + Number(e.inc) : norm(e.set);\n      if (cur !== next) { g.flags[e.flag] = next; w.dirty = true; w.queue.push({ on: 'flag', name: e.flag }); }\n      break;\n    }\n    case 'say':\n      if (e.say !== undefined && e.say !== null) {\n        o.text = e.say;\n        o.msgs.push({ text: e.say, bad: !!e.bad });\n        if (e.bad) o.ok = false;\n        if (e.to === 'team') { g.log = [...g.log, { n: w.n, by: w.by, text: e.say, audio: e.audio }].slice(-30); w.dirty = true; }\n      }\n      if (e.audio) o.audio = e.audio;\n      break;\n    case 'set': setState(w, ref(e.set, rid), e.to); break;\n    case 'show': { const r = ref(e.show, rid); if (g.objs[r.room]?.[r.id] === 'hidden') setState(w, r, 'idle'); break; }\n    case 'hide': setState(w, ref(e.hide, rid), 'hidden'); break;\n    case 'image': { const r = ref(e.image, rid); if (g.objs[r.room]?.[r.id] !== undefined) { g.imgs[`${r.room}:${r.id}`] = e.to; w.dirty = true; } break; }\n    case 'bg': { const r = ref(e.bg, rid); if (w.rooms[r.room]?.views?.[r.id]) { g.bgs[`${r.room}:${r.id}`] = e.to; w.dirty = true; } break; }\n    case 'give': g.inv.push(e.give); w.dirty = true; break;\n    case 'take': { const i = g.inv.indexOf(e.take); if (i >= 0) { g.inv.splice(i, 1); w.dirty = true; } break; }\n    case 'audio': o.audio = e.audio; break;\n    case 'read': o.read = { ...(e.read.text !== undefined && { text: e.read.text }), ...(e.read.image !== undefined && { image: e.read.image }) }; break;\n    case 'goto': { const r = ref(e.goto, rid); o.goto = { room: r.room, view: r.id }; break; }\n    case 'digit': if (w.rooms[e.digit] && !g.shown.includes(e.digit)) { g.shown.push(e.digit); w.dirty = true; } break;\n    case 'solve': solveRoom(w, e.solve); break;\n    default: break;\n  }\n}\n\n// Returns true when a {stop} effect ended the list.\nfunction exec(w, rid, effects) {\n  for (const e of effects || []) {\n    if (e.stop) return true;\n    effect(w, rid, e);\n  }\n  return false;\n}\n\n// Runs every rule matching `ev`. Returns true if at least one branch executed.\nfunction dispatch(w, ev) {\n  let fired = false;\n  for (const [rid, rule] of sources(w, ev)) {\n    const p = parseOn(rule.on);\n    if (!p || !matches(p, ev, rid)) continue;\n    const pass = [].concat(rule.if ?? []).every((c) => holds(w, rid, c));\n    const branch = pass ? rule.do : rule.else;\n    if (!branch || !branch.length) continue;\n    fired = true;\n    if (exec(w, rid, branch)) break;\n  }\n  return fired;\n}\n\n// Drains chained events; after each full drain, implicit room.win checks (legacy `win`) may solve rooms.\nfunction drain(w) {\n  for (;;) {\n    while (w.queue.length) {\n      if (++w.steps > MAX_STEPS) throw new CascadeError(`cascade limit (${MAX_STEPS}) exceeded`);\n      dispatch(w, w.queue.shift());\n    }\n    const touched = [...w.touched];\n    w.touched.clear();\n    for (const rid of touched) {\n      const rm = w.rooms[rid];\n      const need = rm?.win?.requires;\n      if (need && !w.gs.done[rid] && need.every((r) => isDone(w.gs.objs[rid], r))) solveRoom(w, rid);\n    }\n    if (!w.queue.length) break;\n  }\n}\n\nfunction finish(w, gs) {\n  const o = w.out;\n  if (w.dirty) {\n    w.gs.seq = w.n;\n    for (const k of Object.keys(w.gs)) gs[k] = w.gs[k];\n  }\n  return {\n    ok: o.ok, text: o.text, audio: o.audio, changed: w.dirty, solved: w.solved.length > 0,\n    solvedRooms: w.solved, msgs: o.msgs, read: o.read, goto: o.goto,\n  };\n}\n\nconst failed = (e) => {\n  if (!(e instanceof CascadeError)) throw e;\n  return { ok: false, text: '⚠️ زنجیره‌ی رویدادها خیلی طولانی شد؛ اتفاقی نیفتاد', changed: false, error: e.message, msgs: [] };\n};\n\n// rooms: { roomId: interactiveRoom } (the ACTIVE rooms). Mutates gs only if the run succeeds.\nexport function runAct(rooms, roomId, gs, id, withItem, by) {\n  const w = makeWorld(rooms, gs, by, withItem);\n  const o = rooms[roomId]?.objects?.[id];\n  const s = w.gs.objs[roomId]?.[id];\n  if (!o || !s || s === 'hidden' || s === 'taken') return { ok: false, text: '🔎 چیزی اینجا پیدا نشد' };\n  try {\n    let fired = false;\n    if (withItem) fired = dispatch(w, { on: 'use', room: roomId, obj: id, item: withItem });\n    if (!fired) dispatch(w, { on: 'click', room: roomId, obj: id });\n    drain(w);\n  } catch (e) { return failed(e); }\n  return finish(w, gs);\n}\n\nexport function runEnter(rooms, roomId, gs, view, by) {\n  if (!rooms[roomId]?.views?.[view]) return { ok: false, changed: false, msgs: [] };\n  const w = makeWorld(rooms, gs, by, null, view);\n  try {\n    dispatch(w, { on: 'enter', room: roomId, view });\n    drain(w);\n  } catch (e) { return failed(e); }\n  return finish(w, gs);\n}\n\n// ---------------------------------------------------------------------------------------------\n// Validation\nconst EXTRA = { set: ['to'], image: ['to'], bg: ['to'], say: ['to', 'bad', 'audio'], flag: ['set', 'inc'] };\nconst LEAF_EXTRA = { state: ['is', 'isnt'], flag: ['is', 'isnt', 'gte', 'lte'] };\n\nexport const hasSolveFor = (room, id) => {\n  const all = [...(room.rules || []), ...Object.values(room.views || {}).flatMap((v) => v.rules || []),\n    ...Object.values(room.objects || {}).flatMap((o) => o.rules || [])];\n  return all.some((r) => [].concat(r.do || [], r.else || []).some((e) => e.solve === id));\n};\n\n// cx = { rooms: {id: room}, roomId, where: 'object' | 'view' | 'room' }\nexport function ruleErrors(at, rules, cx) {\n  if (rules === undefined) return [];\n  if (!Array.isArray(rules)) return [`${at}: rules must be an array`];\n  const errs = [];\n  const rooms = cx.rooms;\n  const interactive = (rm) => !!rm && typeof rm.objects === 'object';\n  const objOk = (raw) => { if (typeof raw !== 'string' || !raw) return false; const r = ref(raw, cx.roomId); return !!rooms[r.room]?.objects?.[r.id]; };\n  const viewOk = (raw) => { if (typeof raw !== 'string' || !raw) return false; const r = ref(raw, cx.roomId); return !!rooms[r.room]?.views?.[r.id]; };\n  const roomOk = (raw) => typeof raw === 'string' && interactive(rooms[raw]);\n  const itemOk = (raw) => typeof raw === 'string' && Object.values(rooms).some((rm) => rm?.items && raw in rm.items);\n  const str = (v) => typeof v === 'string' && v.length > 0;\n\n  rules.forEach((r, i) => {\n    const p = `${at}.rules[${i}]`;\n    if (!r || typeof r !== 'object' || Array.isArray(r)) { errs.push(`${p}: rule must be an object`); return; }\n    for (const k of Object.keys(r)) if (!['on', 'if', 'do', 'else'].includes(k)) errs.push(`${p}: unknown field \"${k}\"`);\n    const on = parseOn(r.on);\n    if (!on) errs.push(`${p}: bad trigger \"${r.on}\"`);\n    else {\n      if ((on.kind === 'click' || on.kind === 'use') && cx.where !== 'object') errs.push(`${p}: \"${r.on}\" only works on object rules`);\n      if (on.kind === 'enter' && cx.where === 'object') errs.push(`${p}: \"enter\" only works on view or room rules`);\n      if (on.kind === 'use' && !itemOk(on.arg)) errs.push(`${p}: unknown item \"${on.arg}\"`);\n      if (on.kind === 'state' && !objOk(on.arg)) errs.push(`${p}: trigger on unknown object \"${on.arg}\"`);\n      if (on.kind === 'solved' && on.arg !== undefined && !roomOk(on.arg)) errs.push(`${p}: trigger on unknown room \"${on.arg}\"`);\n    }\n    const conds = r.if === undefined ? [] : r.if;\n    if (!Array.isArray(conds)) errs.push(`${p}.if: must be an array`);\n    else conds.forEach((c, j) => {\n      const q = `${p}.if[${j}]`;\n      if (!c || typeof c !== 'object') { errs.push(`${q}: must be an object`); return; }\n      const leaf = LEAVES.find((k) => k in c);\n      if (!leaf) { errs.push(`${q}: unknown check`); return; }\n      for (const k of Object.keys(c)) if (k !== leaf && !(LEAF_EXTRA[leaf] || []).includes(k)) errs.push(`${q}: unexpected field \"${k}\"`);\n      if (leaf === 'state' && !objOk(c.state)) errs.push(`${q}: unknown object \"${c.state}\"`);\n      if (leaf === 'state' && !('is' in c) && !('isnt' in c)) errs.push(`${q}: state needs is or isnt`);\n      if (leaf === 'done') for (const x of [].concat(c.done)) if (!objOk(x)) errs.push(`${q}: unknown object \"${x}\"`);\n      if (leaf === 'has' && !itemOk(c.has)) errs.push(`${q}: unknown item \"${c.has}\"`);\n      if (leaf === 'using' && c.using !== false && !itemOk(c.using)) errs.push(`${q}: unknown item \"${c.using}\"`);\n      if (leaf === 'solved' && !roomOk(c.solved)) errs.push(`${q}: unknown room \"${c.solved}\"`);\n      if (leaf === 'flag' && !str(c.flag)) errs.push(`${q}: flag needs a name`);\n      if (leaf === 'view' && !viewOk(c.view)) errs.push(`${q}: unknown view \"${c.view}\"`);\n    });\n    for (const branch of ['do', 'else']) {\n      const list = r[branch];\n      if (list === undefined) continue;\n      if (!Array.isArray(list)) { errs.push(`${p}.${branch}: must be an array`); continue; }\n      list.forEach((e, j) => {\n        const q = `${p}.${branch}[${j}]`;\n        if (!e || typeof e !== 'object') { errs.push(`${q}: must be an object`); return; }\n        const verb = VERBS.find((k) => k in e);\n        if (!verb) { errs.push(`${q}: unknown effect`); return; }\n        for (const k of Object.keys(e)) if (k !== verb && !(EXTRA[verb] || []).includes(k)) errs.push(`${q}: unexpected field \"${k}\"`);\n        const v = e[verb];\n        if ((verb === 'set' || verb === 'show' || verb === 'hide' || verb === 'image') && !objOk(v)) errs.push(`${q}: unknown object \"${v}\"`);\n        if ((verb === 'set' || verb === 'image' || verb === 'bg') && !str(e.to) && !(verb !== 'set' && e.to && typeof e.to === 'object')) errs.push(`${q}: needs \"to\"`);\n        if (verb === 'bg' && !viewOk(v)) errs.push(`${q}: unknown view \"${v}\"`);\n        if ((verb === 'give' || verb === 'take') && !itemOk(v)) errs.push(`${q}: unknown item \"${v}\"`);\n        if (verb === 'say') {\n          if (typeof v !== 'string') errs.push(`${q}: say needs text`);\n          if (e.to !== undefined && !['actor', 'team'].includes(e.to)) errs.push(`${q}: to must be actor or team`);\n        }\n        if (verb === 'audio' && !str(v)) errs.push(`${q}: audio needs a path`);\n        if (verb === 'read' && !(v && typeof v === 'object' && (str(v.text) || str(v.image)))) errs.push(`${q}: read needs {text} or {image}`);\n        if (verb === 'goto' && !viewOk(v)) errs.push(`${q}: unknown view \"${v}\"`);\n        if (verb === 'flag') {\n          if (!str(v)) errs.push(`${q}: flag needs a name`);\n          if (('set' in e) === ('inc' in e)) errs.push(`${q}: flag needs exactly one of set / inc`);\n          if ('inc' in e && typeof e.inc !== 'number') errs.push(`${q}: inc must be a number`);\n        }\n        if ((verb === 'digit' || verb === 'solve') && !roomOk(v)) errs.push(`${q}: unknown room \"${v}\"`);\n        if (verb === 'stop' && v !== true) errs.push(`${q}: stop must be true`);\n      });\n    }\n    if (r.do === undefined && r.else === undefined) errs.push(`${p}: rule has no do or else`);\n  });\n  return errs;\n}",
    "lib/snapshot": "// PURE snapshot builder shared by the server (game.js) and the editor playtest. No sdk / DB imports.\nimport { isInteractive, publicRoom } from './engine.js';\nimport { stripScene } from './packLoader.js';\n\n// pack: full pack data; active: active room ids; gs: parsed game state; lockLength: team size.\n// Rules, answers and digits of unsolved rooms never leave the server.\nexport function buildSnapshot(pack, active, gs, lockLength) {\n  const scenes = { lobby: stripScene(pack.lobby, active) };\n  const rooms = {};\n  const found = [];\n  const shown = new Set(gs.shown || []);\n  for (const id of active) {\n    const r = pack.rooms[id];\n    if (isInteractive(r)) {\n      rooms[id] = publicRoom(id, r, gs);\n      if (gs.done[id] || shown.has(id)) found.push(...r.digits);\n    } else {\n      scenes[id] = stripScene(r, active);\n    }\n  }\n  return { seq: gs.seq, name: pack.name, lockLength, scenes, rooms, inv: gs.inv, log: gs.log, found };\n}\n\n// { roomId: interactiveRoom } for the active rooms — the shape act()/enter() expect.\nexport function activeInteractive(pack, active) {\n  const out = {};\n  for (const id of active) if (isInteractive(pack.rooms[id])) out[id] = pack.rooms[id];\n  return out;\n}",
    "endpoints/submitCode": "import { requireAnyPlayer } from '../lib/gameApi.js';\nimport { submitCode, snapshotWithEnd } from '../lib/finish.js';\n\n// The exit-lock keypad in the Mini App. `code` is the raw string from the pad\n// (Persian or Latin digits, any order); a correct one ends the match for everyone.\nexport default async function (input, ctx) {\n  const { match, user } = await requireAnyPlayer(ctx);\n  if (match.status !== 'running') return { result: { ok: false, text: '🏁 بازی تمام شده' }, game: await snapshotWithEnd(match, user) };\n  const code = typeof input.code === 'string' ? input.code : '';\n  const out = await submitCode(match, user, code);\n  return { result: out.result, game: await snapshotWithEnd(match, user) };\n}\n"
  },
